     "start_s": 933.6,
     "end_s": 940.0,
     "timecode": "15:33",
     "text": "就让我们离间走远"
    },
    {
     "start_s": 945.3,
     "end_s": 952.4,
     "timecode": "15:45",
     "text": "我们只懂没有空气"
    },
    {
     "start_s": 1046.4,
     "end_s": 1047.4,
     "timecode": "17:26",
     "text": "不是不是不是"
    },
    {
     "start_s": 1048.4,
     "end_s": 1050.4,
     "timecode": "17:28",
     "text": "人说那是不是我想偷"
    },
    {
     "start_s": 1068.9,
     "end_s": 1072.9,
     "timecode": "17:48",
     "text": "相恋 李古一的 李古一的 李古一的"

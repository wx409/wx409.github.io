{
  "你要忘了我": {
    "fragments": [
      {"text": "让我独自在阴雨天，把艳阳留在你身边", "moods": ["释怀", "感伤"], "source": "歌词《你要忘了我》"},
      {"text": "我希望你能忘了我，让回忆在远处沉默", "moods": ["释怀", "告别"], "source": "歌词《你要忘了我》"},
      {"text": "我们曾多么甜蜜的瞬间，锁在那些心酸的相片", "moods": ["回忆", "感伤"], "source": "歌词《你要忘了我》"}
    ]
  },
  "带着一颗好心去流浪": {
    "fragments": [
      {"text": "就让我带着富有的心流浪，好天气给的自由啊", "moods": ["自由", "勇气"], "source": "歌词《带着一颗好心去流浪》"},
      {"text": "我将生出胆魄，埋葬了脆弱", "moods": ["勇气", "励志"], "source": "歌词《带着一颗好心去流浪》"},
      {"text": "趟过慈悲的河，更懂得澎湃和寂寞", "moods": ["治愈", "成长"], "source": "歌词《带着一颗好心去流浪》"},
      {"text": "没人拥抱，却了解的快乐", "moods": ["治愈", "孤独"], "source": "歌词《带着一颗好心去流浪》"}
    ]
  },
  "晚风暖暖": {
    "fragments": [
      {"text": "夜色太美，我还是舍不得睡着", "moods": ["浪漫", "深夜"], "source": "歌词《晚风暖暖》"},
      {"text": "我的心，醉倒在晚风里", "moods": ["浪漫", "思念"], "source": "歌词《晚风暖暖》"},
      {"text": "窗外星光闪耀，有你刚刚好", "moods": ["温暖", "浪漫"], "source": "歌词《晚风暖暖》"}
    ]
  },
  "下沉": {
    "fragments": [
      {"text": "子夜，沉沉呼吸，招揽睡意，拢进身体", "moods": ["深夜", "平静"], "source": "歌词《下沉》"},
      {"text": "要飞的，让它飞着，撩成风，绕着我", "moods": ["释怀", "平静"], "source": "歌词《下沉》"},
      {"text": "要坠的，让它坠落，让它坠成个梦，罩着我沉没", "moods": ["深夜", "失眠"], "source": "歌词《下沉》"}
    ]
  },
  "静止了的夜晚": {
    "fragments": [
      {"text": "时间静止了，停在夜晚", "moods": ["浪漫", "深夜"], "source": "歌词《静止了的夜晚》"},
      {"text": "在心中盛开的爱情，让好多话沉默，可是沉默，你都听来", "moods": ["温暖", "爱情"], "source": "歌词《静止了的夜晚》"},
      {"text": "我美丽平凡的爱情，点亮幸运的我", "moods": ["温暖", "治愈"], "source": "歌词《静止了的夜晚》"}
    ]
  },
  "茕茕": {
    "fragments": [
      {"text": "梦呓幽月，孑然已入月，昼夜泛起思念", "moods": ["思念", "深夜"], "source": "歌词《茕茕》"},
      {"text": "一帘思念，好似在前，思忆化明月", "moods": ["思念", "感伤"], "source": "歌词《茕茕》"},
      {"text": "日复一日，年复一年，似此星辰并非昨夜", "moods": ["回忆", "感伤"], "source": "歌词《茕茕》"}
    ]
  },
  "好好说再见": {
    "fragments": [
      {"text": "那就好好对你说声再见", "moods": ["释怀", "告别"], "source": "歌词《好好说再见》"},
      {"text": "回忆停在旧屋檐，往事风里荡秋千", "moods": ["回忆", "感伤"], "source": "歌词《好好说再见》"},
      {"text": "但愿我能看见你笑着，走回命运的原点", "moods": ["祝福", "释怀"], "source": "歌词《好好说再见》"}
    ]
  },
  "重游往昔": {
    "fragments": [
      {"text": "酒馆里的旧桌椅，半瓶陈酒", "moods": ["回忆", "深夜"], "source": "歌词《重游往昔》"},
      {"text": "愿我只要想念，就能重游往昔", "moods": ["思念", "温暖"], "source": "歌词《重游往昔》"},
      {"text": "时光说到底，情意川流不息", "moods": ["温暖", "回忆"], "source": "歌词《重游往昔》"}
    ]
  },
  "云一定知道": {
    "fragments": [
      {"text": "我爱你，云一定知道", "moods": ["思念", "浪漫"], "source": "歌词《云一定知道》"},
      {"text": "每当思念，掏空了心，剩下一整片蓝色忧郁", "moods": ["思念", "感伤"], "source": "歌词《云一定知道》"},
      {"text": "你说思念，看似无形，却化成全世界的大雨", "moods": ["思念", "感伤"], "source": "歌词《云一定知道》"}
    ]
  },
  "双鱼": {
    "fragments": [
      {"text": "我们是一对困在水中的鱼，互相伤害又互相安慰宽心", "moods": ["感伤", "爱情"], "source": "歌词《双鱼》"},
      {"text": "可惜七秒的记忆，只允许一见钟情", "moods": ["感伤", "浪漫"], "source": "歌词《双鱼》"},
      {"text": "流下的眼泪从来不露痕迹", "moods": ["感伤", "孤独"], "source": "歌词《双鱼》"}
    ]
  },
  "等一等昨天": {
    "fragments": [
      {"text": "回忆像幅画，美的不像话", "moods": ["回忆", "温暖"], "source": "歌词《等一等昨天》"},
      {"text": "当时的快乐，多简单无暇，幸福没那么复杂", "moods": ["治愈", "温暖"], "source": "歌词《等一等昨天》"},
      {"text": "当夕阳刷红了我的发，有个她，还放不下", "moods": ["回忆", "思念"], "source": "歌词《等一等昨天》"}
    ]
  },
  "雪地里寄不出的求救信": {
    "fragments": [
      {"text": "我陪你，写求救信，寄不出去，雪人都不理", "moods": ["孤独", "温柔"], "source": "歌词《雪地里寄不出的求救信》"},
      {"text": "我陪你，把脚印，漏在冰天雪地，逆着光，倒在地，看星星", "moods": ["温柔", "治愈"], "source": "歌词《雪地里寄不出的求救信》"}
    ]
  },
  "歌颂": {
    "fragments": [
      {"text": "一朵花，又绽放，能不能，停下欣赏", "moods": ["治愈", "平静"], "source": "歌词《歌颂》"},
      {"text": "用尚有的自由，为生命的隙缝，让我们歌颂", "moods": ["自由", "治愈"], "source": "歌词《歌颂》"}
    ]
  },
  "游离": {
    "fragments": [
      {"text": "雾里有灯，就会有人，愿意一直等", "moods": ["希望", "治愈"], "source": "歌词《游离》"},
      {"text": "别问爱多深，远方有灯，注定有人，相信着永恒", "moods": ["希望", "浪漫"], "source": "歌词《游离》"},
      {"text": "安静缥缈却奋不顾身，只要有可能", "moods": ["勇气", "治愈"], "source": "歌词《游离》"}
    ]
  },
  "哑光": {
    "fragments": [
      {"text": "有了光的默许，抬眼就看到，平凡奇迹", "moods": ["治愈", "希望"], "source": "歌词《哑光》"},
      {"text": "不反射谁的光，阿光他默默暗自光亮", "moods": ["温柔", "励志"], "source": "歌词《哑光》"},
      {"text": "看扬起的微尘，穿越沉寂，有闪光的自己", "moods": ["励志", "希望"], "source": "歌词《哑光》"}
    ]
  },
  "时空": {
    "fragments": [
      {"text": "习惯了紧跟着人群取暖，一个人回家才不孤单", "moods": ["深夜", "孤独"], "source": "歌词《时空》"},
      {"text": "哼着歌，总会被听到的", "moods": ["希望", "治愈"], "source": "歌词《时空》"},
      {"text": "多么想，一整晚，等月亮探出一小半", "moods": ["深夜", "浪漫"], "source": "歌词《时空》"}
    ]
  },
  "悬念": {
    "fragments": [
      {"text": "悬着的才挂念，无解才更想念", "moods": ["思念", "感伤"], "source": "歌词《悬念》"},
      {"text": "人都是，悬着的才挂念", "moods": ["感伤", "深夜"], "source": "歌词《悬念》"},
      {"text": "雾里看的花儿最美", "moods": ["浪漫", "治愈"], "source": "歌词《悬念》"}
    ]
  },
  "轻信": {
    "fragments": [
      {"text": "我的信任，来自本能，这段即兴旅程，没有剧本", "moods": ["真诚", "勇气"], "source": "歌词《轻信》"},
      {"text": "感性的人，才会幸存", "moods": ["真诚", "治愈"], "source": "歌词《轻信》"},
      {"text": "若放下防备，相爱才会，当之无愧", "moods": ["爱情", "真诚"], "source": "歌词《轻信》"}
    ]
  },
  "分岔": {
    "fragments": [
      {"text": "都曾经过浪漫，浪漫只是无聊上一站", "moods": ["释怀", "感伤"], "source": "歌词《分岔》"},
      {"text": "不要回头看，电视里放着旧日片单", "moods": ["释怀", "深夜"], "source": "歌词《分岔》"},
      {"text": "半生人间游览，分岔路口告别过千万", "moods": ["离别", "释怀"], "source": "歌词《分岔》"}
    ]
  },
  "知晓": {
    "fragments": [
      {"text": "多少人为永远，错过了一秒", "moods": ["感伤", "深夜"], "source": "歌词《知晓》"},
      {"text": "无声中有的答案，不再害怕，或多或少", "moods": ["治愈", "平静"], "source": "歌词《知晓》"},
      {"text": "别怕，无声，期待，祈祷", "moods": ["希望", "治愈"], "source": "歌词《知晓》"}
    ]
  },
  "偏偏": {
    "fragments": [
      {"text": "偏偏你看重的只是简单", "moods": ["温暖", "爱情"], "source": "歌词《偏偏》"},
      {"text": "偏偏你最懂我心中不安", "moods": ["温暖", "爱情"], "source": "歌词《偏偏》"},
      {"text": "还好偏偏，巧合的很圆满", "moods": ["浪漫", "温暖"], "source": "歌词《偏偏》"}
    ]
  },
  "微醺23点08分": {
    "fragments": [
      {"text": "唱情歌的姿态，如果学得明白，会避免很多失态", "moods": ["深夜", "幽默"], "source": "歌词《微醺23点08分》"},
      {"text": "无用的小情怀，也许会被淘汰，确实是种无奈", "moods": ["深夜", "感伤"], "source": "歌词《微醺23点08分》"}
    ]
  },
  "是你": {
    "fragments": [
      {"text": "迷惘的世界里，迷茫的你，孤单的心情眼带笑意", "moods": ["孤独", "温柔"], "source": "歌词《是你》"},
      {"text": "皎洁的月光下，狡黠的你，自由的追逐永不停息", "moods": ["自由", "温柔"], "source": "歌词《是你》"},
      {"text": "孤独的灵魂，相似的姓名", "moods": ["孤独", "深夜"], "source": "歌词《是你》"}
    ]
  },
  "不需要结果": {
    "fragments": [
      {"text": "若答案，是没有，至少我，曾陪你走过", "moods": ["释怀", "温柔"], "source": "歌词《不需要结果》"},
      {"text": "不甘错过，只愿相逢", "moods": ["思念", "感伤"], "source": "歌词《不需要结果》"},
      {"text": "松开了手，放你远走，其实多想要，将你拥入怀中", "moods": ["感伤", "思念"], "source": "歌词《不需要结果》"}
    ]
  },
  "小河": {
    "fragments": [
      {"text": "月光洒落谁的窗，又抚慰着谁的伤", "moods": ["深夜", "治愈"], "source": "歌词《小河》"},
      {"text": "小河默默无语在流淌，哪怕经历风霜", "moods": ["治愈", "平静"], "source": "歌词《小河》"},
      {"text": "走过形形色色的悲伤，走过起起落落的彷徨", "moods": ["感伤", "成长"], "source": "歌词《小河》"}
    ]
  },
  "在路上": {
    "fragments": [
      {"text": "前方骄阳笑容朗朗，眼角有一汪，跃动的光", "moods": ["希望", "励志"], "source": "歌词《在路上》"},
      {"text": "去远方，一路上，浅梦长，天野心茫茫，苍茫春光", "moods": ["自由", "出发"], "source": "歌词《在路上》"},
      {"text": "或许是没希望的奔忙一场，而它的模样，笑得滚烫，仿佛从来没有受过伤", "moods": ["励志", "治愈"], "source": "歌词《在路上》"},
      {"text": "自有方向，有它的方向，心的方向，在路上", "moods": ["出发", "希望"], "source": "歌词《在路上》"}
    ]
  },
  "无尽的夜里": {
    "fragments": [
      {"text": "在无尽的夜里", "moods": ["深夜", "思念"], "source": "歌词《无尽的夜里》"},
      {"text": "海边吹风，就这样飘过我和你，一起跳着，在黄昏雨后的舞曲", "moods": ["浪漫", "思念"], "source": "歌词《无尽的夜里》"},
      {"text": "在我心底，有说不出口的秘密", "moods": ["思念", "深夜"], "source": "歌词《无尽的夜里》"}
    ]
  },
  "鹅毛信": {
    "fragments": [
      {"text": "远方飘落，一封长笺，想念一片一片", "moods": ["思念", "温柔"], "source": "歌词《鹅毛信》"},
      {"text": "左手有思念，右手有问候", "moods": ["思念", "温暖"], "source": "歌词《鹅毛信》"},
      {"text": "雪融在心头，希望在左右", "moods": ["希望", "治愈"], "source": "歌词《鹅毛信》"}
    ]
  },
  "勿扰": {
    "fragments": [
      {"text": "和孤独自由一起，谁都别来打扰我", "moods": ["孤独", "深夜"], "source": "歌词《勿扰》"},
      {"text": "游荡于时间之外，世界请忽略我在", "moods": ["深夜", "孤独"], "source": "歌词《勿扰》"},
      {"text": "此刻，就让我独自藏身", "moods": ["孤独", "深夜"], "source": "歌词《勿扰》"}
    ]
  },
  "明白": {
    "fragments": [
      {"text": "原来手放开，世界还在", "moods": ["释怀", "治愈"], "source": "歌词《明白》"},
      {"text": "爱无需感慨，痛无需释怀，人生最精彩是该，来就会来", "moods": ["释怀", "治愈"], "source": "歌词《明白》"},
      {"text": "花谢了再开，水凉了添柴", "moods": ["治愈", "希望"], "source": "歌词《明白》"}
    ]
  },
  "雷美替胺": {
    "fragments": [
      {"text": "孤独是种习惯，自说自话别见怪", "moods": ["失眠", "深夜"], "source": "歌词《雷美替胺》"},
      {"text": "遗忘是种自由，我却无法拥有", "moods": ["失眠", "感伤"], "source": "歌词《雷美替胺》"},
      {"text": "夜晚的七点半，黄昏渐渐消散，窗外霓虹绚烂", "moods": ["深夜", "失眠"], "source": "歌词《雷美替胺》"}
    ]
  },
  "祝我们随遇而安": {
    "fragments": [
      {"text": "祝我们随遇而安", "moods": ["治愈", "平静"], "source": "歌词《祝我们随遇而安》"},
      {"text": "其实幸福，是种本能，要爱过，要伤过，才会懂", "moods": ["治愈", "释怀"], "source": "歌词《祝我们随遇而安》"},
      {"text": "当黑夜过去，当清晨到来，打开心门，让阳光照进来", "moods": ["希望", "治愈"], "source": "歌词《祝我们随遇而安》"},
      {"text": "杯中有浮沉，起落在心间，最是难得几分闲", "moods": ["平静", "治愈"], "source": "歌词《祝我们随遇而安》"}
    ]
  },
  "平凡又美好的晚上": {
    "fragments": [
      {"text": "在每一个，平凡又美好的晚上", "moods": ["温暖", "治愈"], "source": "歌词《平凡又美好的晚上》"},
      {"text": "每个晚归的人，都有避风港", "moods": ["温暖", "治愈"], "source": "歌词《平凡又美好的晚上》"},
      {"text": "若你懂得，眼前就是诗和远方", "moods": ["治愈", "温暖"], "source": "歌词《平凡又美好的晚上》"}
    ]
  },
  "无我": {
    "fragments": [
      {"text": "无需绽放人海中央，平凡中也能闪光", "moods": ["治愈", "励志"], "source": "歌词《无我》"},
      {"text": "愿成为夜空中那道光，将孩子前途照亮", "moods": ["温暖", "希望"], "source": "歌词《无我》"}
    ]
  },
  "微光之名": {
    "fragments": [
      {"text": "黑暗裹挟着星空，点点微光破苍穹", "moods": ["希望", "励志"], "source": "歌词《微光之名》"},
      {"text": "前方道阻且漫长，理想遥远却绝不退让", "moods": ["励志", "勇气"], "source": "歌词《微光之名》"},
      {"text": "疯狂无需谁原谅，花孤芳也能自赏", "moods": ["自由", "励志"], "source": "歌词《微光之名》"}
    ]
  },
  "不能靠近的朋友": {
    "fragments": [
      {"text": "是有过故事的朋友，对彼此的过往不追究", "moods": ["释怀", "感伤"], "source": "歌词《不能靠近的朋友》"},
      {"text": "偶尔想像你握别人的手，我有些落寞，但情愿放你走", "moods": ["感伤", "释怀"], "source": "歌词《不能靠近的朋友》"},
      {"text": "你别回头，总会有人，代替我给你温柔", "moods": ["温暖", "释怀"], "source": "歌词《不能靠近的朋友》"}
    ]
  },
  "无人岛上": {
    "fragments": [
      {"text": "偶尔也徬徨和迷惘，不需要太勇敢啊，回望，我始终在呢", "moods": ["治愈", "温暖"], "source": "歌词《无人岛上》"},
      {"text": "等你穿过惊涛骇浪一身的风霜，我会用岛上的星光，重新把你照亮", "moods": ["治愈", "温暖"], "source": "歌词《无人岛上》"},
      {"text": "徘徊不定的步伐，会找到自己的梦想", "moods": ["希望", "励志"], "source": "歌词《无人岛上》"}
    ]
  },
  "阳关引": {
    "fragments": [
      {"text": "叹人生，最难欢聚易离别", "moods": ["离别", "感伤"], "source": "歌词《阳关引》"},
      {"text": "更尽一杯酒，歌一阕", "moods": ["离别", "深夜"], "source": "歌词《阳关引》"},
      {"text": "念故人，千里自此共明月", "moods": ["思念", "温暖"], "source": "歌词《阳关引》"}
    ]
  },
  "灯塔": {
    "fragments": [
      {"text": "家是风浪里的那盏灯塔，家是流年中不变的归宿", "moods": ["温暖", "治愈"], "source": "歌词《灯塔》"},
      {"text": "握紧你的手，不向命运屈服", "moods": ["勇气", "温暖"], "source": "歌词《灯塔》"}
    ]
  },
  "过客": {
    "fragments": [
      {"text": "我做了，最遥远最熟悉你的过客", "moods": ["感伤", "孤独"], "source": "歌词《过客》"},
      {"text": "像错过了雨中末班车的乘客，最后剩我，一个", "moods": ["感伤", "孤独"], "source": "歌词《过客》"},
      {"text": "学会了消失的不动声色", "moods": ["孤独", "释怀"], "source": "歌词《过客》"}
    ]
  },
  "暗潮涌动": {
    "fragments": [
      {"text": "多想成为光，深渊中把来路照亮", "moods": ["希望", "勇气"], "source": "歌词《暗潮涌动》"},
      {"text": "有没有一阵狂风，能吹散迷雾重重", "moods": ["勇气", "希望"], "source": "歌词《暗潮涌动》"}
    ]
  },
  "塞北年夜": {
    "fragments": [
      {"text": "我等着没有你的新年，我望着没有你的炊烟", "moods": ["思念", "感伤"], "source": "歌词《塞北年夜》"},
      {"text": "我以为我能放下牵挂，放下那些痴缠挣扎", "moods": ["思念", "释怀"], "source": "歌词《塞北年夜》"}
    ]
  }
}
